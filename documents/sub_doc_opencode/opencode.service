[Unit]
Description=OpenCode Server
After=network.target

[Service]
Type=simple
User=1000
Group=1000
WorkingDirectory=/home/lshm
ExecStart=/home/lshm/.nvm/versions/node/v24.19.0/bin/opencode serve --hostname 0.0.0.0 --port 4096
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="OPENCODE_SERVER_PASSWORD=luoshengming"
Environment="PATH=/home/lshm/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
