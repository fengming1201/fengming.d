斜杠命令
    /add-dir            -- 添加新的工作目录
    /agents             -- 管理 Agent 配置
    /background         -- 将此会话转入后台并释放终端
    /branch             -- 从当前位置创建对话分支
    /btw                -- 提出快速旁问，不中断主对话
    /clear              -- 以空上下文开始新会话；先前会话仍保留在磁盘上可用 /resume 恢复）
    /color              -- 设置本会话的提示栏颜色
    /compact            -- 通过总结迄今对话来释放上下文
    /config             -- 打开配置面板
    /context            -- 以彩色网格可视化当前上下文使用情况
