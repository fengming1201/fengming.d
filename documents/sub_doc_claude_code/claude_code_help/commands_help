    /init               -- 初始化带代码库文档的新 CLAUDE.md 文件
    /insights           -- 生成分析 Claude Code 会话的报告
    /keybindings        -- 打开或创建按键绑定配置文件
    /login              -- 使用 Anthropic 账户登录
    /logout             -- 登出 Anthropic 账户
    /mcp                -- 管理 MCP 服务器
